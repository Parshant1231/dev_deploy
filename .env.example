# ============================================================================
# DevDeploy Environment Variables Configuration
# ============================================================================
# This file serves as a template for environment variables.
# Copy to apps/backend/.env and apps/frontend/.env.local
# Fill in your actual values before running the application.
#
# ⚠️  WARNING: Never commit .env or .env.local files to Git!
#     They contain sensitive information (secrets, API keys, tokens).
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ────────────────────────────────────────────────────────────────────────────

# Node environment (development, staging, production)
NODE_ENV=development

# Server port for backend API
PORT=3001

# API base URL (used for generating links in emails, webhooks, etc.)
API_BASE_URL=http://localhost:3001

# ────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ────────────────────────────────────────────────────────────────────────────

# JWT Secret — used to sign and verify JWT tokens
# IMPORTANT: Generate a strong random value:
#   openssl rand -hex 32
# Minimum length: 32 characters
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-required

# JWT token expiration time
JWT_EXPIRES_IN=7d

# Token Encryption Key — used for AES-256 encryption of GitHub OAuth tokens
# IMPORTANT: Must be exactly 32 bytes when decoded from hex
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key-for-aes256-encryption

# Internal API Key — used by GitHub Actions to authenticate API calls
# Sent as X-Internal-Key header (not a Bearer token)
# IMPORTANT: Generate a strong random value:
#   openssl rand -hex 32
DEVDEPLOY_INTERNAL_KEY=your-internal-api-key-for-github-actions

# ────────────────────────────────────────────────────────────────────────────
# GITHUB OAUTH CONFIGURATION
# ────────────────────────────────────────────────────────────────────────────

# GitHub OAuth App credentials
# Get these from: GitHub → Settings → Developer Settings → OAuth Apps → New OAuth App
# For local development:
#   - Homepage URL: http://localhost:3000
#   - Authorization callback URL: http://localhost:3001/api/v1/auth/github/callback
# For production, use your deployed domain URLs
GITHUB_CLIENT_ID=your-github-oauth-app-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-secret

# GitHub Webhook Secret — used to verify webhook signatures from GitHub
# This is optional but highly recommended for security
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# GitHub Personal Access Token — used by GitHub Actions to trigger deployments
# Create a PAT with scope: workflow, repo
# This token is stored in AWS Secrets Manager in production
DEVDEPLOY_GITHUB_TOKEN=ghp_your-personal-access-token-here

# GitHub repository credentials for CI/CD
# These are used by GitHub Actions workflows to authenticate API calls back to DevDeploy
DEVDEPLOY_REPO_OWNER=Parshant1231
DEVDEPLOY_REPO_NAME=dev_deploy

# ────────────────────────────────────────────────────────────────────────────
# AWS CONFIGURATION
# ────────────────────────────────────────────────────────────────────────────

# AWS region where all resources are deployed
AWS_REGION=us-east-1

# AWS credentials (only needed for local development)
# In production, use IAM roles attached to ECS tasks
# Get these from AWS IAM console
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ────────────────────────────────────────────────────────────────────────────
# DYNAMODB TABLES
# ────────────────────────────────────────────────────────────────────────────

# DynamoDB table names (set by Terraform)
# These are prefixed with "devdeploy-{environment}" in production
DYNAMODB_TABLE_PREFIX=devdeploy

# Individual table names (optional if using prefix)
DYNAMODB_USERS_TABLE=devdeploy-users
DYNAMODB_PROJECTS_TABLE=devdeploy-projects
DYNAMODB_DEPLOYMENTS_TABLE=devdeploy-deployments
DYNAMODB_ENVIRONMENTS_TABLE=devdeploy-environments
DYNAMODB_EVENTS_TABLE=devdeploy-events
DYNAMODB_LOGS_TABLE=devdeploy-logs

# ────────────────────────────────────────────────────────────────────────────
# ECR (ELASTIC CONTAINER REGISTRY)
# ────────────────────────────────────────────────────────────────────────────

# ECR repository URL for pushing Docker images
# Format: {account}.dkr.ecr.{region}.amazonaws.com/{repo-name}
# Get from Terraform output or AWS ECR console
ECR_REPOSITORY_URL=123456789.dkr.ecr.us-east-1.amazonaws.com/devdeploy-api

# ────────────────────────────────────────────────────────────────────────────
# ECS (ELASTIC CONTAINER SERVICE)
# ────────────────────────────────────────────────────────────────────────────

# ECS cluster name (created by Terraform)
ECS_CLUSTER_NAME=devdeploy-dev-cluster

# ECS region
ECS_REGION=us-east-1

# ────────────────────────────────────────────────────────────────────────────
# AWS EVENTBRIDGE
# ────────────────────────────────────────────────────────────────────────────

# EventBridge bus name for deployment events
# Used for triggering workflows based on deployment state changes
EVENTBRIDGE_BUS_NAME=devdeploy-dev-events

# ────────────────────────────────────────────────────────────────────────────
# CLOUDWATCH LOGGING
# ────────────────────────────────────────────────────────────────────────────

# CloudWatch log group names (created by Terraform)
CLOUDWATCH_LOG_GROUP_API=/devdeploy/dev/api
CLOUDWATCH_LOG_GROUP_EVENTS=/devdeploy/dev/events
CLOUDWATCH_LOG_GROUP_DEPLOYMENTS=/devdeploy/dev/deployments

# ────────────────────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATION (NEXT.JS)
# ────────────────────────────────────────────────────────────────────────────

# Backend API URL exposed to frontend (public, viewable in browser)
# For local development: http://localhost:3001
# For production: https://your-alb-dns-name.elb.amazonaws.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# GitHub OAuth App ID exposed to frontend
# Same value as GITHUB_CLIENT_ID (frontend needs this for OAuth flow)
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-oauth-app-id

# Application metadata
NEXT_PUBLIC_APP_NAME=DevDeploy
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development

# ────────────────────────────────────────────────────────────────────────────
# SECRETS MANAGER (PRODUCTION ONLY)
# ────────────────────────────────────────────────────────────────────────────

# AWS Secrets Manager secret names (production)
# These are created by Terraform and store encrypted values
SECRETS_MANAGER_JWT_SECRET_NAME=devdeploy-dev-jwt-secret
SECRETS_MANAGER_TOKEN_ENCRYPTION_KEY_NAME=devdeploy-dev-token-encryption-key
SECRETS_MANAGER_GITHUB_CREDENTIALS_NAME=devdeploy-dev-github-credentials

# ────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY
# ────────────────────────────────────────────────────────────────────────────

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Enable verbose logging for debugging
DEBUG=false

# ────────────────────────────────────────────────────────────────────────────
# SETUP INSTRUCTIONS
# ────────────────────────────────────────────────────────────────────────────
#
# 1. LOCAL DEVELOPMENT SETUP:
#    a) Copy this file to apps/backend/.env
#    b) Copy this file to apps/frontend/.env.local
#    c) Generate strong secrets:
#       JWT_SECRET=$(openssl rand -hex 32)
#       TOKEN_ENCRYPTION_KEY=$(openssl rand -hex 32)
#       DEVDEPLOY_INTERNAL_KEY=$(openssl rand -hex 32)
#    d) Fill in GitHub OAuth credentials from GitHub Settings
#    e) (Optional) Set AWS credentials if testing AWS services locally
#
# 2. PRODUCTION SETUP (AWS):
#    a) Never store secrets in .env or Terraform state files
#    b) Use infrastructure/terraform/environments/dev/secrets.auto.tfvars
#    c) All secrets are stored in AWS Secrets Manager
#    d) ECS automatically injects secrets as environment variables
#    e) Add secrets.auto.tfvars to .gitignore
#
# 3. TESTING CREDENTIALS:
#    Use API_TESTING.md for curl examples to test API endpoints
#
# ────────────────────────────────────────────────────────────────────────────